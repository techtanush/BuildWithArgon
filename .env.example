# Vercel project environment. Set values in provider settings, never in source.
# Vite exposes ONLY this public key. Set before building; change requires rebuild.
VITE_CLERK_PUBLISHABLE_KEY=
# Server only: never prefix the following with VITE_.
CLERK_SECRET_KEY=
# Exact frontend origins, comma-separated, no trailing slash. No wildcards.
CLERK_AUTHORIZED_PARTIES=https://your-app.vercel.app
KERNEL_ORIGIN=https://kernel.example.com
KERNEL_TOKEN=
# Local gateway tests only. Never enable on a hosted deployment.
# NODE_ENV=development
# ALLOW_LOCAL_KERNEL=true
