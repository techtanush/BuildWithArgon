# Foundry × Argon — environment. Copy to argon-app/.env and fill in. Never commit .env.

# --- Kernel ---
KERNEL_HOST=127.0.0.1
KERNEL_PORT=8787
KERNEL_TOKEN=
DATA_DIR=../data
WEB_PUBLIC_DIR=../web/public
WEB_URL=http://localhost:5173
LLM_MODE=live

# --- Gemini (Interactions API; read automatically by google-genai) ---
GEMINI_API_KEY=
LONG_DECODE_POLL_SECONDS=5
LONG_DECODE_MAX_MINUTES=45

# --- Engineering ---
ENGINEERING_EXECUTOR=antigravity
ANTIGRAVITY_AGENT=antigravity-preview-09-2026
MAX_BUILD_ITERATIONS=6
LOCAL_SANDBOX=subprocess
LOCAL_TEST_TIMEOUT_SECONDS=180
GITHUB_SANDBOX_TOKEN=

# --- Scheduler ---
SCHEDULER_TICK_SECONDS=1.0
SCHEDULER_CONCURRENCY=4
TICKET_TIMEOUT_SECONDS=1800
ENG_TICKET_TIMEOUT_SECONDS=3600
DEFAULT_BUDGET_USD=25

# --- Composio (GitHub) ---
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev/api/
GITHUB_POLL_SECONDS=60

# --- Voice ---
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
TTS_MAX_CHARS=600
STT_PRIMARY=browser

# --- Conversation & coordination ---
CHECKER_MODEL_CHECK=true
STANDUP_MINUTES=30
ESCALATE_MINUTES=20

# --- Cloud computers (Cua: github.com/trycua/cua) ---
CUA_MODE=sandbox
CUA_IMAGE=ubuntu
CUA_MAX_STEPS=30
CUA_IDLE_STOP_MINUTES=10

# --- Optional Slack mirror via Composio ---
SLACK_MIRROR_CHANNEL=

# --- Optional price overrides (USD per 1M tokens) ---
# PRICE_GEMINI_3_8_FLASH_IN=
# PRICE_GEMINI_3_8_FLASH_OUT=
