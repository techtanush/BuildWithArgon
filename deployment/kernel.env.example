# Persistent kernel host only. Do not put these values into the browser.
AUTH_MODE=gateway
KERNEL_TOKEN=
DATA_DIR=/data
WEB_PUBLIC_DIR=/app/argon-app/web/public
WEB_URL=https://your-app.vercel.app
LLM_MODE=live
GEMINI_API_KEY=
# Optional paid integrations, enable only when deliberately configured.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
COMPOSIO_API_KEY=
CUA_MODE=off
# Other settings are documented in argon-app/.env.example.
